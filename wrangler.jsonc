{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"compatibility_date": "2026-08-14",
	"compatibility_flags": ["global_fetch_strictly_public"],
	"name": "btnh",
	"main": "@astrojs/cloudflare/entrypoints/server",
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS"
	},
	"observability": {
		"enabled": true
	},
	// GITHUB_TOKEN is a secret, not a var: set it with
	// `wrangler secret put GITHUB_TOKEN` for production, and in a local
	// (gitignored) `.dev.vars` file for `wrangler dev`/`astro dev`. Never
	// commit the token itself.
	"vars": {
		"GITHUB_REPO": "kfir-braun/BTNH",
		"GITHUB_BRANCH": "master"
	}
}