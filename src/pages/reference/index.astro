---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const entries = await getCollection('reference');
---

<BaseLayout title="Reference">
	<h1>Reference</h1>
	<p>Quick-lookup tables. Also used by the AI assistant as citable knowledge.</p>
	<ul>
		{
			entries.map((e) => (
				<li>
					<a href={`/reference/${e.id}`}>{e.data.title}</a> — {e.data.description}
				</li>
			))
		}
	</ul>
</BaseLayout>
