---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Home" description="Free base-building guides and Q&A for GregTech-style modpacks.">
	<h1>BuildTech: New Horizons</h1>
	<p>
		Base building help for <strong>GregTech-style modpacks</strong> (GTNH and similar) — layouts,
		infrastructure, aesthetics, and efficiency. Most of it holds up for modded Minecraft base
		building generally, not just GregTech. Browse the guides below, or{' '}
		<a href="/qna/ask">ask a question</a> and get a real, hand-written answer added to the
		Q&amp;A page.
	</p>
	<ul>
		<li><a href="/guides">Guides</a> — layouts, infrastructure, aesthetics, efficiency</li>
		<li><a href="/reference">Reference</a> — quick-lookup tables (voltage tiers, machine tiers, recipe chains)</li>
		<li><a href="/showcase">Showcase</a> — community build screenshots</li>
		<li><a href="/qna">Q&amp;A</a> — answered player questions</li>
	</ul>
	<footer class="credits">
		<p>
			Voltage-tier casing textures used in the site background are from{' '}
			<a href="https://github.com/ULSTICK/GregTechRefreshed" target="_blank" rel="noopener noreferrer">
				ULSTICK/GregTechRefreshed
			</a>, licensed MIT.
		</p>
	</footer>
</BaseLayout>

<style>
	.credits {
		margin-top: 3rem;
		padding-top: 1rem;
		border-top: 1px solid var(--scroll-border, rgba(255, 255, 255, 0.25));
		font-size: 0.85rem;
		color: var(--scroll-fg-dim, #c7c7cf);
		transition: border-color 0.15s linear, color 0.15s linear;
	}
	.credits a {
		color: inherit;
		text-decoration: underline;
	}
</style>
