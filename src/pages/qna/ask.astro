---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="Ask a Question" description="Submit a base-building question for the BTNH Q&A page.">
	<h1>Ask a Question</h1>
	<p>
		Submit a base-building question and it'll show up in the review queue. There's no live AI
		here — a real person answers by hand, so it may take a little while. Answered questions are
		posted publicly on the <a href="/qna">Q&amp;A page</a>.
	</p>
	<form id="ask-form">
		<label for="question">Your question</label>
		<textarea id="question" name="question" rows="4" minlength="10" maxlength="500" required></textarea>

		<div class="honeypot" aria-hidden="true">
			<label for="website">Leave this field empty</label>
			<input type="text" id="website" name="website" tabindex="-1" autocomplete="off" />
		</div>

		<button type="submit">Submit question</button>
		<p id="ask-status" role="status"></p>
	</form>
</BaseLayout>

<style>
	form {
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
		max-width: 520px;
	}
	textarea {
		font: inherit;
		padding: 0.6rem;
		border-radius: 8px;
		border: 1px solid #333;
		background: #1a1a1a;
		color: inherit;
		resize: vertical;
	}
	.honeypot {
		position: absolute;
		left: -9999px;
	}
	button {
		align-self: flex-start;
		padding: 0.6rem 1.2rem;
		border: none;
		border-radius: 8px;
		background: #2a6df0;
		color: white;
		font: inherit;
		cursor: pointer;
	}
	button:disabled {
		opacity: 0.6;
		cursor: default;
	}
</style>

<script>
	const form = document.getElementById('ask-form') as HTMLFormElement;
	const status = document.getElementById('ask-status')!;
	const button = form.querySelector('button')!;

	form.addEventListener('submit', async (e) => {
		e.preventDefault();
		const data = new FormData(form);
		button.disabled = true;
		status.textContent = 'Submitting…';

		try {
			const res = await fetch('/api/qna/submit', {
				method: 'POST',
				headers: { 'Content-Type': 'application/json' },
				body: JSON.stringify({
					question: data.get('question'),
					website: data.get('website'),
				}),
			});

			if (!res.ok) {
				const body = await res.json().catch(() => ({}));
				status.textContent = body.error ?? 'Something went wrong. Try again later.';
				button.disabled = false;
				return;
			}

			form.reset();
			status.textContent = "Thanks! Your question is in the queue and will be answered soon.";
		} catch {
			status.textContent = 'Network error. Try again later.';
		} finally {
			button.disabled = false;
		}
	});
</script>
