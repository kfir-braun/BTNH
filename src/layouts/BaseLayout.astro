---
import Nav from '../components/Nav.astro';

interface Props {
	title: string;
	description?: string;
}

const { title, description = 'BuildTech: New Horizons — base building for GregTech-style modpacks.' } = Astro.props;
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width" />
		<meta name="description" content={description} />
		<meta name="generator" content={Astro.generator} />
		<title>{title} · BTNH</title>
	</head>
	<body>
		<Nav />
		<main>
			<slot />
		</main>
	</body>
</html>

<script>
	import { initTierScroll } from '../lib/tierScroll';
	initTierScroll();
</script>

<style is:global>
	:root {
		color-scheme: dark;
	}
	body {
		margin: 0;
		font-family: system-ui, sans-serif;
		/* Defaults match the LV stop, so there's no flash before JS runs. */
		background-color: var(--scroll-bg, #34333f);
		/* Brushed-metal texture, modeled on the blocky/maze-like pattern in the
		   owner's own casing screenshots: a soft specular sheen plus one
		   diagonal (single consistent angle) repeating stroke whose bands
		   alternate through three tones - the current tier color itself
		   (--stroke-base, exactly the color pulled from the screenshots),
		   plus a lighter and a darker shade of that same color
		   (--stroke-lighter/--stroke-darker) - all three set live by
		   tierScroll.ts every scroll frame, so the stroke always matches
		   whatever tier color is currently active. Fixed attachment keeps it
		   reading as a material property of the page rather than printed
		   content that scrolls past. */
		background-image:
			radial-gradient(ellipse 120% 60% at 25% -10%, rgba(255, 255, 255, 0.12), transparent 55%),
			repeating-linear-gradient(
				115deg,
				var(--stroke-base, #34333f) 0px,
				var(--stroke-base, #34333f) 6px,
				var(--stroke-lighter, #5a5968) 6px,
				var(--stroke-lighter, #5a5968) 12px,
				var(--stroke-darker, #100f14) 12px,
				var(--stroke-darker, #100f14) 18px
			);
		background-attachment: fixed;
		color: var(--scroll-fg, #f2f2f5);
		transition:
			background-color 0.15s linear,
			color 0.15s linear;
	}
	main {
		max-width: 860px;
		margin: 0 auto;
		padding: 2rem 1.5rem 5rem;
	}
	a {
		color: var(--scroll-link, #8ab4ff);
		transition: color 0.15s linear;
	}
	table {
		border-collapse: collapse;
		width: 100%;
	}
	th,
	td {
		border: 1px solid var(--scroll-border, rgba(255, 255, 255, 0.25));
		padding: 0.4rem 0.7rem;
		text-align: left;
		transition: border-color 0.15s linear;
	}
</style>
