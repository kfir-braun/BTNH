---
import Nav from '../components/Nav.astro';

interface Props {
	title: string;
	description?: string;
}

const { title, description = 'BuildTech: New Horizons — base building for GregTech-style modpacks.' } = Astro.props;
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width" />
		<meta name="description" content={description} />
		<meta name="generator" content={Astro.generator} />
		<title>{title} · BTNH</title>
	</head>
	<body>
		<Nav />
		<main>
			<slot />
		</main>
	</body>
</html>

<script>
	import { initTierScroll } from '../lib/tierScroll';
	initTierScroll();
</script>

<style is:global>
	:root {
		color-scheme: dark;
	}
	body {
		margin: 0;
		font-family: system-ui, sans-serif;
		/* Defaults match the LV stop, so there's no flash before JS runs. */
		background: var(--scroll-bg, #34333f);
		color: var(--scroll-fg, #f2f2f5);
		transition:
			background-color 0.15s linear,
			color 0.15s linear;
	}
	main {
		max-width: 860px;
		margin: 0 auto;
		padding: 2rem 1.5rem 5rem;
	}
	a {
		color: var(--scroll-link, #8ab4ff);
		transition: color 0.15s linear;
	}
	table {
		border-collapse: collapse;
		width: 100%;
	}
	th,
	td {
		border: 1px solid var(--scroll-border, rgba(255, 255, 255, 0.25));
		padding: 0.4rem 0.7rem;
		text-align: left;
		transition: border-color 0.15s linear;
	}
</style>
