---
import Nav from '../components/Nav.astro';

interface Props {
	title: string;
	description?: string;
}

const { title, description = 'BuildTech: New Horizons — base building for GregTech-style modpacks.' } = Astro.props;
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width" />
		<meta name="description" content={description} />
		<meta name="generator" content={Astro.generator} />
		<title>{title} · BTNH</title>
	</head>
	<body>
		<Nav />
		<main>
			<slot />
		</main>
	</body>
</html>

<script>
	import { initTierScroll } from '../lib/tierScroll';
	initTierScroll();
</script>

<style is:global>
	:root {
		color-scheme: dark;
	}
	body {
		margin: 0;
		font-family: system-ui, sans-serif;
		/* Defaults match the LV stop, so there's no flash before JS runs. */
		background-color: var(--scroll-bg, #34333f);
		/* Real in-game casing texture (see tiers.ts / Home page credit) as the
		   background, tiled at a chunky upscale so it reads as blocky
		   material rather than a smear, plus a soft specular sheen on top.
		   Uses the mirror-tiled 32x32 version (see tiers.ts) rather than the
		   raw 16x16 texture directly - repeating the raw tile makes every
		   repeat boundary an obvious "border" between identical icons, while
		   mirroring each quadrant makes every seam line up so it reads as
		   one continuous surface instead of a tiled grid. --tier-texture is
		   swapped by tierScroll.ts every scroll frame to match whichever
		   tier is currently active. image-rendering: pixelated keeps the
		   upscale crisp instead of blurry. Fixed attachment keeps it reading
		   as a material property of the page rather than printed content
		   that scrolls past. */
		background-image:
			radial-gradient(ellipse 120% 60% at 25% -10%, rgba(255, 255, 255, 0.12), transparent 55%),
			var(--tier-texture, url(/textures/casings-mirrored/lv.png));
		background-repeat: no-repeat, repeat;
		background-size:
			100% 100%,
			96px 96px;
		background-attachment: fixed;
		image-rendering: pixelated;
		color: var(--scroll-fg, #f2f2f5);
		transition:
			background-color 0.15s linear,
			color 0.15s linear;
	}
	main {
		max-width: 860px;
		margin: 0 auto;
		padding: 2rem 1.5rem 5rem;
	}
	a {
		color: var(--scroll-link, #8ab4ff);
		transition: color 0.15s linear;
	}
	table {
		border-collapse: collapse;
		width: 100%;
	}
	th,
	td {
		border: 1px solid var(--scroll-border, rgba(255, 255, 255, 0.25));
		padding: 0.4rem 0.7rem;
		text-align: left;
		transition: border-color 0.15s linear;
	}
</style>
